@model IEnumerable<RoleToReturnDto>
@{
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">
   

    <form class="mb-4">
        <h2 class="text-primary">Roles</h2>
        <div class="input-group" style="max-width: 500px;">
            <input type="text" placeholder="Search for a role..." id="searchInput" name="searchInput" class="form-control" />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create Role
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().Id)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>
                                <div class="d-flex flex-wrap">
                                    <a asp-action="Details" asp-route-Id="@item.Id" class="btn btn-outline-secondary btn-sm mx-1" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-Id="@item.Id" class="btn btn-outline-success btn-sm mx-1" title="Edit Role">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-Id="@item.Id" class="btn btn-outline-danger btn-sm mx-1" title="Delete Role">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                    <a asp-action="AddOrRemoveUsers" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mx-1" title="Manage Users">
                                        <i class="bi bi-people"></i>
                                    </a>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <h5 class="mb-0"><i class="bi bi-info-circle"></i> No roles found.</h5>
        </div>
    }
</div>
