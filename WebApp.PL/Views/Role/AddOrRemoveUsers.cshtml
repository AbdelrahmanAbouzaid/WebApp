@model List<UserInRoleDto>

@{
    ViewData["Title"] = "Add or Remove Users";
    var id = TempData["id"] as string;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 bg-white p-4 rounded shadow">
            <h2 class="text-center text-primary mb-4">Manage Users in Role</h2>
            <hr />

            <form asp-action="AddOrRemoveUsers">
                <div class="mb-4">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="form-check mb-2">
                            <input asp-for="@Model[i].UserId" type="hidden" />
                            <input asp-for="@Model[i].UserName" type="hidden" />
                            <input asp-for="@Model[i].IsSelected" class="form-check-input" id="userCheck_@i" />
                            <label class="form-check-label" for="userCheck_@i">
                                @Model[i].UserName
                            </label>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success"> Update</button>
                    <a asp-action="Index" class="btn btn-secondary"> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
