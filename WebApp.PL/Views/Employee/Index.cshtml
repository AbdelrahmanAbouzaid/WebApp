@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employees";
}

<h1 class="mb-4 text-primary">Employees</h1>
<form class="mb-4" >
    <div class="input-group" style="max-width: 500px;">
        <input type="text" placeholder="Search for an employee..." id="searchInput" name="searchInput" class="form-control" />
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
</form>

<p>
    <a class="btn btn-success" asp-action="Create">
        <i class="bi bi-plus-circle"></i> Create Employee
    </a>
</p>

<div id="employeeList">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th></th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Age)</th>
                        <th>@Html.DisplayNameFor(model => model.Address)</th>
                        <th>@Html.DisplayNameFor(model => model.Phone)</th>
                        <th>@Html.DisplayNameFor(model => model.Salary)</th>
                        <th>@Html.DisplayNameFor(model => model.HiringDate)</th>
                        <th>@Html.DisplayNameFor(model => model.Department)</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/files/images/@(string.IsNullOrEmpty(item.ImageName) ? "default.jpg" : item.ImageName)"
                                     width="50" height="50" class="img-thumbnail rounded-circle" alt="Employee Image" />
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Age)</td>
                            <td>@Html.DisplayFor(modelItem => item.Address)</td>
                            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                            <td>@Html.DisplayFor(modelItem => item.Salary)</td>
                            <td>@Html.DisplayFor(modelItem => item.HiringDate)</td>
                            <td>
                                @(item.Department != null ? item.Department.Name : "No Department")
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-wrap justify-content-center">
                                    <a asp-action="Details" asp-route-Id="@item.Id" class="btn btn-outline-secondary btn-sm mx-1" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-Id="@item.Id" class="btn btn-outline-success btn-sm mx-1" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-Id="@item.Id" class="btn btn-outline-danger btn-sm mx-1" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4" role="alert">
            <strong>No employees found.</strong> Try creating one!
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#searchInput').on('input', function () {
                var searchValue = $(this).val();

                $.ajax({
                    url: '@Url.Action("Search", "Employee")',
                    type: 'GET',
                    data: { searchInput: searchValue },
                    success: function (data) {
                        $('#employeeList').html(data);
                    }
                });
            });
        });
    </script>
}
