@model SignInDto
@{
    ViewData["Title"] = "Sign In";
}

<div class="container d-flex justify-content-center align-items-center my-5">
    <div class="col-md-5 col-lg-4 bg-white p-5 rounded shadow">
        <h2 class="text-center text-primary mb-4">🔐 Welcome Back!</h2>

        <form asp-action="SignIn">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
            </div>
            <div class="text-center mt-4">
                <p class="mb-2">Or sign in with</p>
                <a asp-action="GoogleLogin" asp-route-provider="Google" class="btn btn-outline-dark d-flex align-items-center justify-content-center gap-2">
                    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" style="height: 20px;" />
                    <span>Sign in with Google</span>
                </a>
            </div>
            <p class="text-center mt-3">
                Don’t have an account?
                <a asp-action="SignUp" class="text-primary text-decoration-none">Sign Up</a>
            </p>
            <p class="text-center">
                <a asp-action="ForgetPassword" class="text-muted small">Forgot password?</a>
            </p>
        </form>
        

    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}