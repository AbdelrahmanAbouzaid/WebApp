@model IEnumerable<Department>
@{
    ViewData["Title"] = "Departments";
}

<h4 class="mb-4 text-primary">Departments</h4>

<p>
    <a class="btn btn-success" asp-action="Create">
        <i class="bi bi-plus-circle"></i> Create Department
    </a>
</p>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Code)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Maneger)</th>
                    <th>@Html.DisplayNameFor(model => model.CreateAt)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Code)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Maneger)</td>
                        <td>@Html.DisplayFor(modelItem => item.CreateAt)</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm mx-1" title="View Details">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mx-1" title="Edit Department">
                                    <i class="bi bi-pencil-square"></i> Update
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm mx-1" title="Delete Department">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning mt-4 text-center" role="alert">
        <strong>No departments found!</strong> Please create a department to get started.
    </div>
}
