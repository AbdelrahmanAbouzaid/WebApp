@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4">
            Welcome @if (User.Identity.IsAuthenticated)
            {
                <span>, @User.Identity.Name!</span>
            }
            else
            {
                <span>!</span>
            }
        </h1>
        <p class="lead">Manage your organization with ease</p>
    </div>

    <div class="row g-4">
        <!-- Employee Management Card -->
        <div class="col-md-6">
            <div class="card shadow-lg p-3 border-0 animate__animated animate__zoomIn">
                <div class="text-center mb-3">
                    <i class="bi bi-person-badge-fill" style="font-size: 5rem; color: #0d6efd;"></i>
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title">Employee Management</h3>
                    <p class="card-text">Add, update, and manage your employees in one place.</p>
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-primary">Go to Employees</a>
                </div>
            </div>
        </div>

        <!-- Department Management Card -->
        <div class="col-md-6">
            <div class="card shadow-lg p-3 border-0 animate__animated animate__zoomIn">
                <div class="text-center mb-3">
                    <i class="bi bi-building" style="font-size: 5rem; color: #198754;"></i>
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title">Department Management</h3>
                    <p class="card-text">Manage departments, assign managers, and view structure.</p>
                    <a asp-controller="Department" asp-action="Index" class="btn btn-success">Go to Departments</a>
                </div>
            </div>
        </div>
    </div>
</div>
